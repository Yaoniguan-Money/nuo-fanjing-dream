{
  "name": "guizhou-dream-experience",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "validate:content": "node scripts/validate-content.mjs && vitest run src/domain/dream-card/content.test.ts",
    "validate:assets": "node scripts/validate-dream-assets.mjs",
    "validate": "npm run validate:content",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "gsap": "3.15.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.185.4",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "happy-dom": "20.11.12",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
