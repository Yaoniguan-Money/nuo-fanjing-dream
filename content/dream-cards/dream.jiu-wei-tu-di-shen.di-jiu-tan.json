  "meta": {
    "id": "dream.jiu-wei-tu-di-shen.di-jiu-tan",
    "version": "0.2.1",
    "title": "第九坛",
    "synopsis": "九坛村外九座社坛一字排开，头坛香火最旺，第九坛只管村尾一片乱石坡。“我”家祖辈守着第九坛，却嫌它误了前程——备考县试、想跟堂哥文生进衙门当差、又跟货郎学算账，四样心思一把抓，样样做不精：县试批语“字是好字，心是散的”，衙门缺额早被占，货栈的账也扒拉不对。灰袍木面的神秘人先问“两只手都攥着，你到底想拿哪一样”；老庙祝点破“坛是人分的大小，神自己没分过，九位爷各有其位，村里的水、田、路、林才不乱”。天旱泉眼将淤，“我”在坡上被神秘人点醒——心一直搁在泉和渠里，遂认准“把坡上的水治明白”，把书帖压在界石底下，连淘五日泉、垒通旧渠，水进秧田，旱情得解。次年春社，“我”认下这个不起眼的岗位：差事有大小，轻重有先后；能把散乱的心力安回各自位置、让手头那一处重新运转的人，就是持衡者。",
    "match": {
      "tags": ["持衡", "纠结", "选择", "取舍", "优先", "排序", "先做", "先顾", "先后", "太多", "都重要", "顾不过来", "忙不过来", "很忙", "最重要", "分心", "注意力", "精力", "兼顾", "平衡", "摊太开", "一团乱", "承担太多", "分工", "安排", "主次", "两头忙"],
      "situations": ["什么都想要样样做不精", "被他人的成功标准裹挟", "看不清自己最想做的那件事", "本职被冷落出现险情", "需要认准一件事持续发力"],
      "emotions": ["心气高", "发虚", "不服", "咯噔自省", "踏实发热"],
      "dilemmas": ["四样心思先抓哪一样", "考功名还是守好本职", "承认自己未必样样出众还是继续摊开抓"],
      "relationships": ["父子", "同族", "同村长辈", "个人与香火"],
      "excludeTags": []
    },
    "officeCandidates": [
