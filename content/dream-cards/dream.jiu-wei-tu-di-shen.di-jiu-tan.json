{
  "$schema": "../../docs/dream-card/dream-card.schema.json",
  "schemaVersion": "0.1.0",
  "meta": {
    "id": "dream.jiu-wei-tu-di-shen.di-jiu-tan",
    "version": "0.1.0",
    "title": "第九坛",
    "synopsis": "九坛村外九座社坛一字排开，头坛香火最旺，\"我\"家祖祖辈辈守着只管一片乱石坡的第九坛。二十出头的石生嫌自家的坛丢人，想去投奔贩山货发财的堂哥宝生，却被一句\"那活儿适合你\"堵在镇口；守庙五十年的老庙祝告诉他：坛是人分的大小，神自己没分过。当族里议定秋社并坛，石生在暴雨夜的乱石坡上想起坡上的泉眼、修渠的石料和救过全村的秋草，认下了这片养着村子却没人谢的地。秋社当天他当众拦下并坛，扶正界石、重修坛墙、凿新的青石香炉，为第九坛上了头一炷新香。次年春社，灰袍木面的神秘人告知：把自己的地守明白的人，就是守界人。",
    "match": {
      "tags": ["九位土地神", "土地公", "社坛", "守界", "职业羞耻", "并坛", "界石"],
      "situations": ["被同龄人比下去", "被他人定义位置", "看轻自己的出身与职责", "外部评价压来", "需要守住自己的位置"],
      "emotions": ["羞耻", "不服", "委屈", "醒悟", "笃定"],
      "dilemmas": ["别人的成功是否是量自己的尺子", "守着没出息的位置还是去跑人家的码头", "当众反对族中议定还是随大流"],
      "relationships": ["父子", "同族", "同龄人", "个人与香火"],
      "excludeTags": []
    },
    "officeCandidates": [
      {
        "officeId": "office.shou-jie",
        "fit": 1,
        "reason": "故事核心是分清何者属于自己并守住必要边界：当众拦下并坛、扶正界石、重上香火，结尾由守界职司交棒。"
      }
    ],
    "tone": ["社日", "山村", "钝痛", "醒悟", "立住"],
    "estimatedDurationSeconds": 380,
    "culturalSources": [
      {
        "id": "source.tudi-shen-she-jisi",
        "title": "土地神（社神）信仰与春社秋社祭社传统",
        "region": "中国乡土／贵州傩堂戏",
        "reference": "reference-materials/dream-card-source/九位土地神.md",
        "note": "借用社神信仰与傩堂戏土地角色（引路、问事、护坛）的守地意象；九坛村、\"九坛有大小\"设定、石生、宝生与并坛风波均为本篇虚构。"
      }
