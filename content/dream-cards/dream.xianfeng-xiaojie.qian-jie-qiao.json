  "meta": {
    "id": "dream.xianfeng-xiaojie.qian-jie-qiao",
    "version": "0.1.0",
    "title": "千结桥",
    "synopsis": "断云江畔的青崖镇只有雷家一个渡口，渡主雷五人称雷半江，垄断江面七年。十七岁的索桥匠之女阿绾为给病中的阿婆抓药，受尽勒索；她决意继承七年前坠江而亡的父亲未竟的架桥遗愿，带着爹留下的绳索图样，与哑叔连夜在老鸦口架起索桥，第一个踏绳过江采药。回程时雷五割断主索，阿绾吊在江心拒绝下跪；全镇人闻锣而来，千手接绳，重新绷直了绳索。新桥落成，雷家渡无人问津，雷五摘下铜锁投入江中离去。桥头雾中，灰袍木面的神秘人揭示：头一个把脚踏上绳的人，就是先锋。",
    "match": {
      "tags": ["先锋小姐", "渡口", "架桥", "强权", "结绳", "反抗", "父亲遗愿"],
      "situations": ["被权威把持前路", "被不公规则勒索", "亲人急需救助", "继承先人遗业", "需要第一个行动"],
      "emotions": ["压抑", "憋屈", "恐惧", "愤怒", "坚定", "释然"],
      "dilemmas": ["面对强权是跪是站", "忍气吞声还是自己开路", "孤身犯险还是等待他人"],
      "relationships": ["祖孙", "父女", "个体与强权", "个人与全镇"],
      "excludeTags": []
    },
    "officeCandidates": [
      {
        "officeId": "office.kailu",
        "fit": 1,
        "reason": "故事核心是在强权拦路处做第一个把脚踏上绳的人，自己开路并带动众人共渡，结尾由先锋小姐原型揭示交棒。"
      }
