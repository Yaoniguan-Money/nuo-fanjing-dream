{
  "$schema": "../../docs/dream-card/dream-card.schema.json",
  "schemaVersion": "0.1.0",
  "meta": {
    "id": "dream.liuyi.yi-xin-du-shui",
    "version": "0.1.0",
    "title": "一信渡水",
    "synopsis": "千年前，江南水乡泽口村秋汛毁田、租税不减，少女阿沅的父亲护田病倒。她宁可替人浆洗、夜里织布，也不肯开口向族中三叔公求助——怕被看轻，怕给父亲丢脸，一封写好的求援信被压在枕下。独撑数日，卖布被压价，药包摔进雨水泥洼，她在河边摸出火折子欲烧信。渡口雾中，戴木面的神秘人现身，讲起千年前泾河边牧羊女向陌生书生开口求援的故事：信不送出去就只是一张纸，开口不是认输，是把声音送到能回应它的人那里。阿沅攥信走到三叔公门前，三次转身后终于叩门开口，粮与大夫当夜而至。数日后她把那封未送出的信放入河水，戴面人摘面自承是千年前替开口女子送信的柳毅——先开口的那个人，不丢人。",
    "match": {
      "tags": ["柳毅", "传书", "水乡", "秋汛", "求援信", "开口求助", "渡口"],
      "situations": ["羞于开口求助", "怕被看轻怕欠人情", "话到嘴边咽下", "独自硬撑家中难处", "需要第一次开口"],
      "emotions": ["羞怯", "倔强", "挣扎", "释然", "被接住"],
      "dilemmas": ["开口是否等于丢脸", "求助是否等于交出命运", "回应不保证时是否开口"],
      "relationships": ["父女", "族亲邻里", "神灵与少女", "求助者与回应者"],
      "excludeTags": []
    },
    "officeCandidates": [
      {
        "officeId": "office.chuan-sheng",
        "fit": 1,
        "reason": "故事核心是把写好未送的话当面开口，让声音抵达能回应它的人，结尾由柳毅摘面揭示交棒。"
      }
    ],
    "tone": ["水乡", "秋汛", "低回", "紧绷", "释然"],
