        "逃避全部责任",
        "要求替自己作决定",
        "否认既有关系",
        "单纯时间管理"
      ]
    },
    "officeCandidates": [
      {
        "officeId": "office.gui-hun",
        "fit": 1,
        "reason": "阿岩没有从多重身份中寻找唯一真身，而是辨认哪些已经写完、哪些仍愿承担，再亲手排列先后并将散页装订成册，完整体现归魂职司的自我认领与整合。"
      }
    ],
    "tone": [
