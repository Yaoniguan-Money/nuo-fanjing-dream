        "自我整合"
      ],
      "situations": [
        "同时承担多种身份与责任",
        "习惯答应所有人却不断失约",
        "总由下一件急事决定生活方向",
        "担心选择优先级等于否认其他自己",
        "需要结束旧角色并重新安排当下生活"
      ],
      "emotions": [
        "忙乱",
        "愧疚",
