{
  "$schema": "../../docs/dream-card/dream-card.schema.json",
  "schemaVersion": "0.1.0",
  "meta": {
    "id": "dream.xianfeng-xiaojie.yi-suo-hua",
    "version": "0.1.1",
    "title": "一梭花",
    "synopsis": "山坳里的寨子家家有织机，十七岁的阿素手快，一天能织三尺平纹布，却一心想让布上开花。她买不起八十文一绞的红丝线，更买不起两百文的花本，便夜里拆旧衣攒线、照三年前货郎带来的花绦数纱，拿炭把花样描在木板上，一纱一纱自己试着起花。旧织机吃不住密花样断了轴，换轴要好料一百文，她一度说要把机子扛去集上卖了；灰袍木面的神秘人夜里拦在机前——线是一根一根攒的，钱不也一样？你的花，才走到半道上。她咬牙留下机子，白日织平布、夜里自己给断轴接榫。寨里人被这份不舍打动，细妹打头，姐妹们凑料凑线，木匠叔连夜给机子接骨。半个月后第一匹花布织成，货郎要全收，她却把自描的花本送出去两份——花样就是让人织的。晨雾中神秘人揭晓：愿望不能只藏在心里，敢把心头所愿接到手上、一梭一梭织成形的人，就是承愿者。",
    "match": {
      "tags": ["承愿", "愿望", "心愿", "想要", "真想", "一直想", "想学", "喜欢", "热爱", "梦想", "决定", "下决心", "兑现", "落实", "坚持", "放弃", "机会", "许可", "条件", "没钱", "没有钱", "没时间", "没有时间", "没人教", "没有老师", "值不值得", "付出", "代价", "等待"],
      "situations": ["真心喜欢却被条件卡住", "买不起想要的工具材料", "没人教只能自己摸索", "一度想放弃所爱", "需要守住心头所愿"],
      "emotions": ["痒", "闷", "着迷", "灰心", "滚烫", "敞亮"],
      "dilemmas": ["条件不齐时是等还是先上手", "卖机认命还是咬牙留住", "花样传出去会不会吃亏"],
      "relationships": ["母女", "邻里姐妹", "个人与所爱", "个人与寨子"],
      "excludeTags": []
    },
    "officeCandidates": [
      {
        "officeId": "office.cheng-yuan",
        "fit": 1,
        "reason": "故事核心不是等条件齐才行动，而是把心头所愿认下来、接到手上，一梭一梭织成现实，结尾由先锋小姐的催愿、勾愿职能揭示承愿交棒。"
      }
    ],
    "tone": ["山寨", "机声", "闷痒", "炽热", "敞亮"],
    "estimatedDurationSeconds": 420,
    "culturalSources": [
      {
        "id": "source.dejiang-nuotangxi-xianfeng-xiaojie",
        "title": "贵州傩堂戏《霸王抢仙锋》先锋小姐",
        "region": "贵州德江",
        "reference": "reference-materials/dream-card-source/先锋小姐.md",
        "note": "借用先锋小姐（崔良玉／仙锋小姐／武先锋）催愿、勾愿与让愿望进入行动的精神内核；阿素、山寨、花绦、织机断轴与花布故事均为本篇虚构。"
      }
    ],
    "status": "draft"
